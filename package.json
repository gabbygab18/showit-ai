{
  "name": "showit-ai",
  "version": "1.1.5",
  "private": true,
  "description": "Showit AI: checks and fixes the mobile layout of Showit sites by driving the Showit editor.",
  "author": "Gabriel Andrei Villanueva",
  "type": "commonjs",
  "main": "electron/main.cjs",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "node scripts/launch.mjs --dev",
    "start": "vite build && node scripts/launch.mjs",
    "build": "vite build",
    "dist": "vite build && electron-builder --win",
    "typecheck": "tsc --noEmit",
    "chrome": "node connect.js",
    "audit": "node audit.js",
    "fix": "node fix.js",
    "test": "node audit.js --selftest && node rebuild.js --selftest"
  },
  "dependencies": {
    "playwright-core": "1.65.0"
  },
  "build": {
    "appId": "com.gab.showitai",
    "productName": "Showit AI",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "*.js",
      "avatar.svg",
      "build/icon.png",
      "package.json"
    ],
    "asarUnpack": [
      "*.js",
      "avatar.svg",
      "node_modules/playwright-core/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Showit AI",
      "artifactName": "Showit-AI-win-x64-setup.${ext}"
    }
  },
  "allowScripts": {
    "electron": true,
    "esbuild": true
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "clsx": "^2.1.1",
    "electron": "^38.8.6",
    "electron-builder": "^26.18.0",
    "figma-squircle": "^1.1.0",
    "motion": "^13.5.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-use-measure": "^2.1.7",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.4",
    "typescript": "^5.9.3",
    "vite": "^7.3.7"
  }
}
